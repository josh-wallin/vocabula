[
  {"id":"l01-1","section":1,"title":"Tullia monet","titleEn":"Tullia gives advice",
   "context":"Tullia, a teacher, talks with her pupil Marcus, who keeps getting things wrong.",
   "sentences":[
    {"tokens":[{"form":"Mārce","lemma":"proper","cell":"voc.sg","proper":true,"gloss":"Marcus (a Roman man's name)","comma":true},{"form":"saepe","lemma":"saepe-indecl","cell":"citation"},{"form":"errās","lemma":"erro-v1","cell":"pres.act.ind.2sg"}],"en":"Marcus, you often make mistakes!","punct":"!","speaker":"Tullia"},
    {"tokens":[{"form":"errō","lemma":"erro-v1","cell":"pres.act.ind.1sg","comma":true},{"form":"sī","lemma":"si-indecl","cell":"citation"},{"form":"nōn","lemma":"non-indecl","cell":"citation"},{"form":"cōgitō","lemma":"cogito-v1","cell":"pres.act.ind.1sg"}],"en":"I make mistakes if I do not think.","speaker":"Mārcus"},
    {"tokens":[{"form":"saepe","lemma":"saepe-indecl","cell":"citation"},{"form":"cōgitāre","lemma":"cogito-v1","cell":"pres.act.inf"},{"form":"dēbēs","lemma":"debeo-v2","cell":"pres.act.ind.2sg"}],"en":"You ought to think often.","speaker":"Tullia"},
    {"tokens":[{"form":"saepe","lemma":"saepe-indecl","cell":"citation"},{"form":"cōgitō","lemma":"cogito-v1","cell":"pres.act.ind.1sg","comma":true},{"form":"nihil","lemma":"nihil-indecl","cell":"citation"},{"form":"videō","lemma":"video-v2","cell":"pres.act.ind.1sg"}],"en":"I often think, and I see nothing!","punct":"!","speaker":"Mārcus"},
    {"tokens":[{"form":"sī","lemma":"si-indecl","cell":"citation"},{"form":"nihil","lemma":"nihil-indecl","cell":"citation"},{"form":"vidēs","lemma":"video-v2","cell":"pres.act.ind.2sg","comma":true},{"form":"monēre","lemma":"moneo-v2","cell":"pres.act.inf"},{"form":"dēbeō","lemma":"debeo-v2","cell":"pres.act.ind.1sg"}],"en":"If you see nothing, I ought to advise you.","speaker":"Tullia"},
    {"tokens":[{"form":"sī","lemma":"si-indecl","cell":"citation"},{"form":"monēs","lemma":"moneo-v2","cell":"pres.act.ind.2sg","comma":true},{"form":"nōn","lemma":"non-indecl","cell":"citation"},{"form":"errō","lemma":"erro-v1","cell":"pres.act.ind.1sg"}],"en":"If you advise me, I do not make mistakes.","speaker":"Mārcus"},
    {"tokens":[{"form":"nōn","lemma":"non-indecl","cell":"citation"},{"form":"errās","lemma":"erro-v1","cell":"pres.act.ind.2sg","comma":true},{"form":"Mārce","lemma":"proper","cell":"voc.sg","proper":true,"gloss":"Marcus (a Roman man's name)"}],"en":"You are not making mistakes, Marcus!","punct":"!","speaker":"Tullia"},
    {"tokens":[{"form":"cōgitās","lemma":"cogito-v1","cell":"pres.act.ind.2sg","comma":true},{"form":"Mārce","lemma":"proper","cell":"voc.sg","proper":true,"gloss":"Marcus (a Roman man's name)","comma":true},{"form":"laudāre","lemma":"laudo-v1","cell":"pres.act.inf"},{"form":"dēbeō","lemma":"debeo-v2","cell":"pres.act.ind.1sg"}],"en":"You are thinking, Marcus; I ought to praise you.","speaker":"Tullia"}
