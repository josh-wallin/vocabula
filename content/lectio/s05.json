[
  {"id":"l05-1","section":5,"title":"Glōria et sapientia","titleEn":"Glory and wisdom",
   "context":"Young Sextus wants glory in war; his mother Cornelia is worried.",
   "sentences":[
    {"tokens":[{"form":"Sextus","lemma":"proper","cell":"nom.sg","proper":true,"gloss":"Sextus (a Roman man's name)"},{"form":"glōriam","lemma":"gloria-n1","cell":"acc.sg"},{"form":"magnam","lemma":"magnus-adj12","cell":"acc.sg.f"},{"form":"amat","lemma":"amo-v1","cell":"pres.act.ind.3sg"}],"en":"Sextus loves great glory."},
    {"tokens":[{"form":"crās","lemma":"cras-indecl","cell":"citation"},{"form":"in","lemma":"in-indecl","cell":"citation"},{"form":"bellō","lemma":"bellum-n2n","cell":"abl.sg"},{"form":"glōriam","lemma":"gloria-n1","cell":"acc.sg"},{"form":"habēbō","lemma":"habeo-v2","cell":"fut.act.ind.1sg"}],"en":"Tomorrow I will have glory in war!","punct":"!","speaker":"Sextus"},
