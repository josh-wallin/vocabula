    {"tokens":[{"form":"animus","lemma":"animus-n2m","cell":"nom.sg"},{"form":"meus","lemma":"meus-adj12","cell":"nom.sg.m"},{"form":"magnus","lemma":"magnus-adj12","cell":"nom.sg.m"},{"form":"et","lemma":"et-indecl","cell":"citation"},{"form":"līber","lemma":"liber-adj12","cell":"nom.sg.m"},{"form":"est","lemma":"sum-irr-sum","cell":"pres.act.ind.3sg"}],"en":"My spirit is great and free.","speaker":"Sextus"},
    {"tokens":[{"form":"sine","lemma":"sine-indecl","cell":"citation"},{"form":"sapientiā","lemma":"sapientia-n1","cell":"abl.sg"},{"form":"animus","lemma":"animus-n2m","cell":"nom.sg"},{"form":"magnus","lemma":"magnus-adj12","cell":"nom.sg.m"},{"form":"perīculum","lemma":"periculum-n2n","cell":"nom.sg"},{"form":"est","lemma":"sum-irr-sum","cell":"pres.act.ind.3sg"}],"en":"Without wisdom a great spirit is a danger.","speaker":"Cornēlia"},
    {"tokens":[{"form":"propter","lemma":"propter-indecl","cell":"citation"},{"form":"glōriam","lemma":"gloria-n1","cell":"acc.sg"},{"form":"multī","lemma":"multus-adj12","cell":"nom.pl.m"},{"form":"virī","lemma":"vir-n2m","cell":"nom.pl"},{"form":"errābant","lemma":"erro-v1","cell":"impf.act.ind.3pl"}],"en":"Because of glory many men used to go astray.","speaker":"Cornēlia"},
    {"tokens":[{"form":"verba","lemma":"verbum-n2n","cell":"acc.pl"},{"form":"tua","lemma":"tuus-adj12","cell":"acc.pl.n"},{"form":"cōgitābō","lemma":"cogito-v1","cell":"fut.act.ind.1sg","comma":true},{"form":"sed","lemma":"sed-indecl","cell":"citation"},{"form":"glōriam","lemma":"gloria-n1","cell":"acc.sg"},{"form":"amābō","lemma":"amo-v1","cell":"fut.act.ind.1sg"}],"en":"I will think about your words, but I will love glory.","speaker":"Sextus"},
