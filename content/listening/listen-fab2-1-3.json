  {
   "ref": "line 4",
   "text": "Hunc timor impugnat verba movente lupō:"
  },
  {
   "ref": "line 5",
   "text": "“Rūpistī pōtumque mihi rīvōque decōrem.”"
  },
  {
   "ref": "line 6",
   "text": "Agnus utrumque negat sē ratiōne tuēns:"
  },
  {
   "ref": "line 7",
   "text": "“Nec tibi nec rīvō nocuī: nam prōna supīnum"
  },
  {
   "ref": "line 8",
   "text": "nescit iter nec adhūc unda nitōre caret.”"
  },
  {
   "ref": "line 9",
   "text": "Sīc iterum tonat ōre lupus: “Mihi damna mināris?”"
  },
  {
   "ref": "line 10",
   "text": "“Nōn minor,” agnus ait. Cui lupus: “Immō facis;"
  },
  {
   "ref": "line 11",
   "text": "Fēcit idem tuus ante pater sex mēnsibus āctīs:"
  },
  {
   "ref": "line 12",
   "text": "Cum bene patrissēs, crīmine patris obī.”"
  },
  {
   "ref": "line 13",
   "text": "Agnus ad haec: “Tantō nōn vīxī tempore, praedō.”"
  },
  {
   "ref": "line 14",
   "text": "Sīc tonat: “An loqueris, furcifer?” huncque vorat."
  },
  {
   "ref": "line 15",
   "text": "Sīc nocet innocuō nocuus, causamque nocendī"
  },
  {
   "ref": "line 16",
   "text": "invenit. Hī rēgnant quālibet urbe lupī."
  }
